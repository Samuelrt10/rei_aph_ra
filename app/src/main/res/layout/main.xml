<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg_app"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<!-- Header Banner Card -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			android:background="@drawable/bg_card_header"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:padding="24dp">

			<ImageView
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:layout_marginBottom="12dp"
				android:contentDescription="@string/app_title"
				android:src="@drawable/ic_medical_cross" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/app_title"
				android:textColor="@color/text_on_primary"
				android:textSize="22sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/app_subtitle"
				android:textColor="#94A3B8"
				android:textSize="14sp" />
		</LinearLayout>

		<!-- Evaluator Profile Card -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			android:background="@drawable/bg_card"
			android:orientation="vertical"
			android:padding="20dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:text="Perfil del Evaluador"
				android:textColor="@color/text_primary"
				android:textSize="16sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="Nombre"
				android:textColor="@color/text_secondary"
				android:textSize="12sp" />

			<EditText
				android:id="@+id/edtNombreEvaluador"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:layout_marginBottom="16dp"
				android:background="@drawable/bg_badge"
				android:hint="Ej. Dr. Juan Pérez"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:textColor="@color/text_primary"
				android:textColorHint="@color/text_muted"
				android:textSize="14sp"
				android:inputType="textPersonName"
				android:autofillHints="name" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="Nivel de Estudios"
				android:textColor="@color/text_secondary"
				android:textSize="12sp" />

			<Spinner
				android:id="@+id/spinnerNivelEstudios"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:background="@drawable/bg_badge"
				android:entries="@array/niveles_estudio"
				android:paddingStart="8dp"
				android:paddingEnd="8dp" />

			<!-- Botón de Google en Forma de Círculo (debajo del nivel de estudios) -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="vertical"
				android:layout_marginTop="20dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="O rellena rápidamente con:"
					android:textSize="12sp"
					android:textColor="@color/text_muted"
					android:layout_marginBottom="8dp"/>

				<ImageButton
					android:id="@+id/btnSignInGoogle"
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:background="@drawable/bg_circle_white"
					android:src="@drawable/ic_google"
					android:elevation="2dp"
					android:scaleType="centerInside"
					android:padding="12dp"
					android:contentDescription="Iniciar sesión con Google"/>
			</LinearLayout>

		</LinearLayout>

		<!-- Instructions Card -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="16dp"
			android:background="@drawable/bg_card"
			android:orientation="vertical"
			android:padding="20dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ImageView
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:contentDescription="@string/instructions_title"
					android:src="@drawable/ic_info" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:text="@string/instructions_title"
					android:textColor="@color/text_primary"
					android:textSize="16sp"
					android:textStyle="bold" />
			</LinearLayout>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:lineSpacingExtra="4dp"
				android:text="@string/instruction_step1"
				android:textColor="@color/text_secondary"
				android:textSize="14sp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:lineSpacingExtra="4dp"
				android:text="@string/instruction_step2"
				android:textColor="@color/text_secondary"
				android:textSize="14sp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:lineSpacingExtra="4dp"
				android:text="@string/instruction_step3"
				android:textColor="@color/text_secondary"
				android:textSize="14sp" />
		</LinearLayout>

		<!-- Start Simulation Button -->
		<Button
			android:id="@+id/button1"
			android:layout_width="match_parent"
			android:layout_height="56dp"
			android:layout_marginBottom="12dp"
			android:background="@drawable/bg_button_start"
			android:drawableStart="@drawable/ic_stethoscope"
			android:drawablePadding="12dp"
			android:paddingStart="24dp"
			android:paddingEnd="24dp"
			android:text="@string/btn_start_simulation"
			android:textAllCaps="false"
			android:textColor="@color/text_on_primary"
			android:textSize="18sp"
			android:textStyle="bold" />

	</LinearLayout>
</ScrollView>
